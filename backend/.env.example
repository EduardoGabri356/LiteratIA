NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/literatia

# Origens permitidas (separadas por vírgula). Vite usa 5173 por padrão.
CORS_ORIGINS=http://localhost:5173

# Gemini: só é exigida quando as rotas de IA forem implementadas.
# Confira o nome do modelo na documentação atual do Google antes de usar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
# true = Fase 2 gera a questão de cada hotspot com IA (cai na estática se o Gemini falhar)
AI_HOTSPOT_QUESTIONS=false

# Rate limit por janela (ms). O limite de IA é por sessão (X-Session-UUID).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=15
